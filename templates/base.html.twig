<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="">
        <meta name="author" content="">
        <title>{% block title %}Serie2Ouf{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <!-- Bootstrap core CSS -->
            <link href="{{ asset('css/bootstrap-5.3.8-dist/css/bootstrap.min.css') }}" rel="stylesheet">
            <link href="{{ asset('css/bootstrap-icons-1.13.1/font/bootstrap-icons.min.css') }}" rel="stylesheet">

            <!-- DataTables CSS local -->
            <link rel="stylesheet" href="{{ asset('css/dataTables.bootstrap5.min.css') }}">

            <!-- Styles personnalisés -->
            <link href="{{ asset('css/shop-homepage.css') }}" rel="stylesheet">
            <link href="{{ asset('css/design.css') }}" rel="stylesheet">
        {% endblock %}
    </head>
    <body>
        <!-- Navigation -->
        {% include 'nav.html.twig' %}
        <!-- Page Content -->
        <main class="container-fluid" style="margin:auto;min-height:750px;">
            {% block body %}{% endblock %}
        </main>
        <!-- Footer -->
        {% include 'footer.html.twig' %}
        <script>
            const header = document.querySelector(".s2o-header");
            const ajuster = () =>
                (document.body.style.paddingTop = header.offsetHeight + "px");
            ajuster();
            window.addEventListener("resize", ajuster);
        </script>
        {% block javascripts %}
            <!-- jQuery local -->
            <script src="{{ asset('js/jquery-3.7.1.min.js')}}"></script>
            <!-- Bootstrap JS local -->
            <script src="{{ asset('css/bootstrap-5.3.8-dist/js/bootstrap.bundle.min.js')}}"></script>
            <!-- DataTables JS local -->
            <script src="{{ asset('js/jquery.dataTables.min.js')}}"></script>
            <script src="{{ asset('js/dataTables.bootstrap5.min.js')}}"></script>
        {% endblock %}
    </body>
</html>
